---
const data = [
  {
    company: "Solara6",
    position: "Software Engineer",
    time: "2025 - Present",
    link: "https://www.solara6.com/",
  },
  {
    company: "Edgio",
    position: "Fullstack developer",
    time: "2024 - 2025",
    link: "https://edg.io/",
  },
  {
    company: "Resonance Holding Inc.",
    position: "Frontend developer",
    time: "2021 - 2024",
    link: "https://resonance.vision/",
  },
];
---

<div class="card card-experience">
  <h3 class="heading">
    <span class="heading-default"> 3 years of </span>
    <span class="heading-accent">Experience</span>
  </h3>
  <ul class="list">
    {
      data.map(({ company, position, time, link }, i) => (
        <li class="list-item">
          <p class="date">{time}</p>
          <h4 class="header">
            {position}
            {i === 0 && <span class="accent-icon">⭐</span>}
          </h4>
          <a href={link} target="_blank" class="company">
            {company}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .card-experience,
  .card-experience:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 1.5rem;
  }
  .heading-default {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    opacity: 0.6;
  }

  .heading-accent {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 500;
    opacity: 0.9;
  }
  .list-item {
    list-style-type: none;
    padding-top: 1rem;
    padding-bottom: 1rem;
    transition: all 0.3s linear;
  }

  .accent-icon {
    font-size: 1rem;
  }

  .date {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    opacity: 0.65;
  }

  .company {
    font-size: 0.875rem;
    line-height: 1.25rem;
    opacity: 0.8;
    color: var(--card-color);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    display: block;
    max-width: max-content;
  }

  .company:hover {
    transform: scale(1.2);
  }
  .list-item:first-child {
    border-left: 4px solid;
    border-image: linear-gradient(90deg, #007bff, #00c4ff) 1;
    padding-left: 12px;
  }

  .list-item:first-child .header {
    font-size: 1.875rem;
    line-height: 2.25rem;
    margin-bottom: 0.5rem;
    color: var(--button-active-bg);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .list-item:not(:first-child) {
    opacity: 0.6;
    color: #a1a1a6;
  }

  .list-item:not(:first-child) .header {
    font-size: 1.5rem;
    line-height: 2rem;
    margin-bottom: 0.5rem;
    font-weight: 400;
  }
</style>
