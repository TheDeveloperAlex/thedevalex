<div class="card card-info">
  <div class="header">
    <img src="/public/avatar_2.webp" alt="TheDevAlex" class="photo" />
    <h1 class="heading">Oleksandr Semenenko</h1>
  </div>
  <p class="content">
    I'm a JavaScript software developer 3+ years of experience. I am developing
    performance-oriented JavaScript applications using React.js, Next.js.
  </p>
</div>

<style>
  .card-info {
    display: flex;
    flex-direction: column;
  }
  .header {
    display: flex;
    align-items: center;
  }
  .photo {
    border-radius: 50%;
  }
  .heading {
    font-weight: 500;
  }
  .content {
    color: rgba(255, 255, 255, 0.7);
  }

  @media screen and (max-width: 639px) {
    .card-info {
      align-items: center;
      gap: 16px;
    }
    .header {
      flex-direction: column;
      gap: 8px;
    }
    .photo {
      width: 64px;
      height: 64px;
    }
    .heading {
      font-size: 1.5rem;
      line-height: 1.5rem;
    }
    .content {
      font-size: 1rem;
    }
  }

  @media screen and (min-width: 640px) {
    .card-info {
      gap: 24px;
    }
    .header {
      flex-direction: row;
      gap: 16px;
    }
    .photo {
      width: 96px;
      height: 96px;
    }
    .heading {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
    .content {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
  }
</style>
